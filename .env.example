NODE_ENV=development
APP_ENV=development
CLIENT_URL=http://localhost:5173
PORT=4000
DATABASE_URL=file:./server/prisma/dev.db
SESSION_SECRET=change-this-session-secret
ADMIN_EMAIL=admin@riddler.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!
MUSIC_TRACK_PATH=/audio/odyssey-theme.mp3
SOUNDS_ENABLED=true
MUSIC_ENABLED=true
PAUSE_ON_FULLSCREEN_EXIT=true
PAUSE_ON_TAB_HIDDEN=false
ALLOW_TEAM_NAME_REUSE=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
VITE_API_BASE_URL=http://localhost:4000/api
VITE_MUSIC_TRACK_PATH=/audio/odyssey-theme.mp3
VITE_MUSIC_ENABLED=true
VITE_SOUNDS_ENABLED=true
